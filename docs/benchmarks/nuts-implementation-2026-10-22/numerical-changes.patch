+#[test]
+fn cached_velocities_are_rebuilt_and_metric_failures_recover_without_committing() {
+    use alea_math::metric::{EuclideanMetric, MetricError};
+    use alea_mcmc::hamiltonian::PhaseError;
+    struct Metric {
+        calls: Cell<usize>,
+        fail: Cell<usize>,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alea-descriptive-v2",
  "title": "Descriptive PosteriorDB protocol",
  "description": "pdb.py additionally enforces cross-field seeds, pins, source seals and exact planned denominators. No promotion or scientific pass/fail fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "purpose",
    "corpus",
    "methods",
    "chains",
    "seeds",
    "warmup",
    "draws",
    "repetitions",
    "depth",
    "timeout_seconds",
    "maximum_output_bytes",
    "rmhmc",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "purpose": {
      "const": "descriptive"
    },
    "corpus": {
      "type": "string"
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "nuts_cov_diag",
          "nuts_cov_dense",
          "nuts_fisher_diag",
          "nuts_fisher_rank4",
          "nuts_fisher_rm",
          "nuts_fisher_adam",
          "nuts_atlas_joint",
          "nuts_pathfinder",
          "nuts_transport",
          "hmc_cov",
          "hmc_omf",
          "hmc_bcss",
          "ghmc",
          "drghmc",
          "mams",
          "mclmc",
          "chees",
          "walnuts_d",
          "walnuts_r2p",
          "rmhmc_softabs",
          "rmhmc_manifold",
          "stan_nuts_diag",
          "stan_nuts_dense",
          "stan_pathfinder_nuts",
          "blackjax_nuts",
          "nuts_rs"
        ]
      }
    },
    "chains": {
      "type": "integer",
      "minimum": 1
    },
    "seeds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "warmup": {
      "type": "integer",
      "minimum": 1
    },
    "draws": {
      "type": "integer",
      "minimum": 1
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_output_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "rmhmc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_dimension",
        "warmup",
        "draws",
        "timeout_seconds"
      ],
      "properties": {
        "maximum_dimension": {
          "type": "integer",
          "minimum": 1
        },
        "warmup": {
          "type": "integer",
          "minimum": 1
        },
        "draws": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "schema_version": 1,
  "id": "m16-smoke-v1",
  "purpose": "correctness_ci",
  "corpus": "tools/bench/corpus/v1.json",
  "engines": [
    "alea"
  ],
  "policy": {
    "algorithm": "multinomial_nuts",
    "geometry": "identity",
    "adaptation": "none",
    "warmup": 16,
    "draws": 64,
    "depth": 5,
    "energy_limit": 1000.0,
    "precision": "float64",
    "chains": 4,
    "seeds": [
      16001,
      16002,
      16003,
      16004
    ],
    "repetitions": 1
  },
  "resources": {
    "threads": 1,
    "timeout_seconds": 60,
    "maximum_output_bytes": 33554432,
    "maximum_cases": 128
  },
  "thresholds": {
    "maximum_rhat": 1.2,
    "minimum_ess": 10.0,
    "maximum_divergence_rate": 0.1,
    "maximum_depth_rate": 0.5,
    "mean_mcse_multiplier": 6.0,
    "mean_absolute_tolerance": 0.2,
    "gradient_absolute_tolerance": 1e-05,
    "gradient_relative_tolerance": 0.0001,
    "minimum_speedup": 1.5,
    "confidence": 0.95,
    "bootstrap_resamples": 200,
    "maximum_failure_rate_increase": 0.0,
    "maximum_time_regression": 1.2
  },
  "calibration": {
    "cases": [
      "latent_gaussian"
    ],
    "datasets": 4,
    "seed": 16300,
    "bins": 4,
    "maximum_rank_chi_square": 16.27,
    "minimum_coverage": 0.25,
    "maximum_coverage": 1.0
  },
  "excluded_claims": [
    "Correctness smoke only; no promotion or timing alert",
    "Short chains may fail scientific diagnostics and remain in the report"
  ],
  "engine_differences": {
    "alea": "Fixed identity geometry and fixed-discard warmup; analytic scores; ChaCha12 logical streams; serialization excluded from retained time"
  }
}
